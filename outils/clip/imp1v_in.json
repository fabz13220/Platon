{"src": "/mnt/project-files/matiere-premiere/9x16/par-jeu/11-l-imposteur.mp4", "tag": "Un seul tel.<br>Plus personne ne ment.", "beats": [{"t0": 0, "t1": 2.6, "cap": "CE SOIR, UN DE TES POTES VA TE *MENTIR* EN FACE", "clip": [13.0, 15.0], "zoom": [1.15, 1.3], "focus": [50, 40], "glow": "#ff2d8a", "gap": 0.15, "say": "Ce soir, un de tes potes va te mentir en face."}, {"t0": 2.6, "t1": 4.6, "cap": "TOUT LE MONDE A LE MÊME MOT…", "clip": [9.0, 11.0], "zoom": [1.0, 1.12], "focus": [50, 42], "glow": "#22c3e6", "say": "Tout le monde reçoit le même mot..."}, {"t0": 4.6, "t1": 6.4, "cap": "…SAUF *LUI*", "clip": [13.4, 15.0], "zoom": [1.5, 1.7], "focus": [50, 40], "glow": "#ff2d8a", "flash": true, "say": "sauf lui.", "pause": 0.35}, {"t0": 6.4, "t1": 9.0, "cap": "CHACUN DIT UN MOT. LUI, IL *IMPROVISE*", "clip": [24.0, 26.6], "zoom": [1.0, 1.1], "focus": [50, 45], "glow": "#22c3e6", "say": "Chacun dit un mot. Lui, il improvise."}, {"t0": 9.0, "t1": 11.2, "cap": "TON POTE DIT « SABLE »…", "clip": [17.0, 19.0], "zoom": [1.0, 1.1], "focus": [50, 42], "glow": "#7b2bff", "say": "Ton meilleur pote dit « sable »..."}, {"t0": 11.2, "t1": 13.2, "cap": "LE MOT C'ÉTAIT *FORÊT*", "clip": [17.5, 19.0], "zoom": [1.45, 1.65], "focus": [50, 42], "glow": "#22c3e6", "hl": "#13a37a", "say": "alors que le mot, c'est « forêt »."}, {"t0": 13.2, "t1": 15.0, "cap": "VOUS VOTEZ.", "clip": [27.0, 29.0], "zoom": [1.0, 1.12], "focus": [50, 45], "glow": "#ffd23f", "say": "Vous votez.", "pause": 0.3}, {"t0": 15.0, "t1": 17.6, "cap": "*GRILLÉ*", "clip": [29.4, 32.0], "zoom": [1.2, 1.35], "focus": [50, 38], "glow": "#ff2d8a", "flash": true, "say": "Grillé.", "pause": 1.1}, {"t0": 17.6, "t1": 20.4, "cap": "", "end": true, "glow": "#7b2bff", "say": "BLIZ. Un seul tel, et plus personne ne ment."}]}