{
  "appId": "fr.bliz.app",
  "appName": "BLIZ",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#061224"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#061224",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/app-check": {
            "symlink": true
          }
        }
      }
    }
  }
}
